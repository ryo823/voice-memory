[Unit]
Description=Back up the voice-memory database and recordings

[Service]
Type=oneshot
WorkingDirectory=%h/voice-memory
ExecStart=%h/voice-memory/.venv/bin/voice-memory-backup
Nice=15
# Off-site copy; set up the 'gdrive' rclone remote first (see README). Remove this line for a local-only backup.
Environment=VOICE_MEMORY_RCLONE_REMOTE=gdrive:voice-memory-backup
